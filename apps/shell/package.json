{
  "name": "@genoffice/shell",
  "productName": "AiOffice",
  "version": "1.2.10",
  "license": "Apache-2.0",
  "homepage": "https://github.com/genspark-ai/genoffice",
  "private": true,
  "description": "Unified GenOffice shell: one app hosting the docs and sheets modules behind a home/launcher window",
  "main": "out/main/index.js",
  "desktopName": "genoffice.desktop",
  "scripts": {
    "dev": "npm run build:native:auth && electron-vite dev --watch",
    "build": "electron-vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:native:auth": "node scripts/build-auth-session.mjs",
    "start": "npm run build:native:auth && electron-vite build && node scripts/start-macos-app.mjs",
    "dist:mac": "npm run build:native:auth && electron-vite build && electron-builder --mac",
    "dist:mas": "AIOFFICE_BUILD_MAS=1 npm run build:native:auth && electron-vite build && AIOFFICE_BUILD_MAS=1 electron-builder --mac mas --arm64",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux"
  },
  "devDependencies": {
    "@genoffice/agent-core": "*",
    "@genoffice/ai-provider": "*",
    "@genoffice/ai-search": "*",
    "@genoffice/docs": "*",
    "@genoffice/docx-engine": "*",
    "@genoffice/electron-utils": "*",
    "@genoffice/i18n": "*",
    "@genoffice/pptx-engine": "*",
    "@genoffice/pptx-render": "*",
    "@genoffice/sheets": "*",
    "@genoffice/slides": "*",
    "@genoffice/ui": "*",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.0.12",
    "electron-updater": "^6.8.9",
    "electron-vite": "^5.0.0",
    "officecrypto-tool": "^0.0.19",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.10"
  },
  "author": "AiOffice"
}
